{
  "name": "genedai-send",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An open-source email workspace built on Cloudflare.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --port 8793",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply genesend --local",
    "db:remote": "wrangler d1 migrations apply genesend --remote",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/dm-serif-display": "^5.2.8",
    "@sendgrid/eventwebhook": "^8.0.0",
    "hono": "^4.10.0",
    "lucide-react": "^0.468.0",
    "postal-mime": "^2.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svix": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "miniflare": "^5.20261023.1-beta",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
