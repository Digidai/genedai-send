{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genesend",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "48d9ccaf5ee7914c803b5d0656462848",
  "workers_dev": true,
  "routes": [{ "pattern": "send.genedai.me", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*", "/u/*", "/webhooks/*", "/t/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "genesend",
      "database_id": "9d3442ba-bacb-4a7d-98e4-1c2d96b0064d",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "genesend-content" }],
  "queues": {
    "producers": [{ "binding": "SEND_QUEUE", "queue": "genesend-delivery" }],
    "consumers": [
      {
        "queue": "genesend-delivery",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "genesend-delivery-dlq",
      },
    ],
  },
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_URL": "https://send.genedai.me",
    "SENDING_DOMAINS": "genedai.me",
    "CLOUDFLARE_EMAIL_ACCOUNT_ID": "48d9ccaf5ee7914c803b5d0656462848",
    "SEND_ENABLED": "true",
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
